# Copie para .env e preencha. NUNCA versionar segredos.
NODE_ENV=development
PORT=3000
# Banco dedicado (ver deploy/docker-compose.dev.yml). Use 127.0.0.1 no Windows.
DATABASE_URL=postgresql://aerogest:TROQUE_A_SENHA@127.0.0.1:5439/aerogest?schema=public
POSTGRES_PASSWORD=TROQUE_A_SENHA
# Origem permitida (CORS) — URL do frontend
APP_ORIGIN=http://localhost:5173
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Chave AES-256 (32 bytes em base64) para cifrar segredos de MFA:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=8
# true em produção (HTTPS obrigatório)
COOKIE_SECURE=false
# true em produção: ADMIN/CHEFE/COMANDANTE precisam ativar MFA para operar
MFA_ENFORCE_PRIVILEGED=false
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
UPLOAD_MAX_MB=20
# S3 compatível (somente em ambiente autorizado)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
COMPRAS_BASE_URL=https://dadosabertos.compras.gov.br
INTEGRATION_TIMEOUT_MS=15000
JOBS_ENABLED=true
TZ_APP=America/Sao_Paulo
